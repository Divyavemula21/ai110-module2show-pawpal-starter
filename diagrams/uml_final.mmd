classDiagram
    %% PawPal+ — daily pet care planning assistant (FINAL, matches pawpal_system.py)
    %% Ownership chain: Owner --> Pet --> CareTask
    %% The scheduler does NOT own tasks; it reads them from the owner at plan time.

    class Owner {
        +String name
        +float available_hours
        +dict preferences
        +List~Pet~ pets
        +ScheduleManager schedule
        +add_pet(pet) void
        +all_tasks() List~CareTask~
        +update_profile(name, available_hours) void
        +available_minutes() int
    }

    class Pet {
        +String name
        +String pet_type
        +int age
        +List~CareTask~ tasks
        +get_profile_summary() String
        +add_task(task) void
        +remove_task(title) void
    }

    class CareTask {
        +String title
        +int duration
        +String frequency
        +String priority
        +bool is_completed
        +date due_date
        +String time
        -Pet pet
        +update_task_details(duration, priority) void
        +toggle_complete() void
        +mark_complete() void
        +priority_weight() int
    }

    class ScheduleManager {
        +List~CareTask~ daily_plan
        -List~CareTask~ _considered
        -List~String~ _active_warnings
        +collect_tasks(owner) List~CareTask~
        +sort_by_time(owner) List~CareTask~
        +filter_tasks(owner, pet_name, completed) List~CareTask~
        +complete_task_and_recur(task) CareTask
        +check_conflicts(owner) List~String~
        +generate_daily_schedule(owner, available_minutes) List~CareTask~
        +get_schedule_explanation() String
    }

    %% Structural ownership
    Owner "1" o-- "0..*" Pet : cares for
    Owner "1" *-- "1" ScheduleManager : owns
    Pet "1" *-- "0..*" CareTask : has
    CareTask "0..*" --> "1" Pet : belongs to

    %% The scheduler operates on the owner and references the tasks it plans
    ScheduleManager ..> Owner : reads tasks from
    ScheduleManager "1" o-- "0..*" CareTask : plans (daily_plan)
